#!/usr/bin/env bash

# ── Configuration ─────────────────────────────────────────────
SESSION="dev"
EDITOR_CMD="nvim"
AI_CMD="claude"
RIGHT_WIDTH="28%"
BOTTOM_HEIGHT="21%"
# ──────────────────────────────────────────────────────────────

setup_layout() {
  local main="$1"
  local right bottom
  right=$(tmux split-window -h -t "$main" -l "$RIGHT_WIDTH" -P -F '#{pane_id}')
  bottom=$(tmux split-window -v -t "$main" -l "$BOTTOM_HEIGHT" -P -F '#{pane_id}')
  tmux resize-pane -t "$right"  -x "$RIGHT_WIDTH"
  tmux resize-pane -t "$bottom" -y "$BOTTOM_HEIGHT"
  tmux send-keys -t "$main"  "$EDITOR_CMD" Enter
  tmux send-keys -t "$right" "$AI_CMD"     Enter
  tmux select-pane -t "$main"
}

if [ -n "$TMUX" ]; then
  setup_layout "$(tmux new-window -P -F '#{pane_id}')"
  exit 0
fi

if tmux has-session -t "$SESSION" 2>/dev/null; then
  tmux attach-session -t "$SESSION"
  exit 0
fi

MAIN=$(tmux new-session -d -s "$SESSION" \
  -x "$(tput cols)" -y "$(tput lines)" \
  -P -F '#{pane_id}')
setup_layout "$MAIN"
tmux attach-session -t "$SESSION"
